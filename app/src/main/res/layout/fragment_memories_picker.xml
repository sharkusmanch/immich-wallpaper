<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/memories_title"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/memories_explainer"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/memories_availability"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="14sp"
            android:textStyle="italic" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/memories_window_heading"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/memories_window_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/memories_window_day"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/memories_window_day" />

            <RadioButton
                android:id="@+id/memories_window_3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/memories_window_3" />

            <RadioButton
                android:id="@+id/memories_window_week"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/memories_window_week" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/memories_years_heading"
            android:textSize="16sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/memories_years_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/memories_years_all"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/memories_years_all" />

            <RadioButton
                android:id="@+id/memories_years_last"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/memories_years_last" />

            <RadioButton
                android:id="@+id/memories_years_older"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/memories_years_older" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/memories_continue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/memories_continue" />
    </LinearLayout>
</ScrollView>
