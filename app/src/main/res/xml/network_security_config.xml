<?xml version="1.0" encoding="utf-8"?>
<!-- Self-hosted servers are commonly plain HTTP on the LAN (e.g. http://192.168.x.x:2283).
     Allow cleartext so user-entered HTTP base URLs work; HTTPS URLs are unaffected. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
